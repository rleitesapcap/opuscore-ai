# =============================================================================
# OPUSCORE-AI — variáveis de ambiente
# Copie para config/.env (fora do git, nunca comitar) e preencha os segredos.
# Linhas comentadas (#) = opcionais; sem elas, vale o padrão do código.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SAP (conexão ADT, read-only)
# -----------------------------------------------------------------------------
SAP_USER=DEVELOPER
SAP_PASSWORD=trocar-aqui

# -----------------------------------------------------------------------------
# 2. IA principal (chat, Etapa 1 da EF, Consultor MM, motor de ET)
# -----------------------------------------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL_MAIN=claude-opus-5-5
# Obrigatório com o claude-opus-5-5 (o modelo recusa o parâmetro temperature):
LLM_TEMPERATURE=off

# Modelo da leitura de EF (Etapa 1) e do Consultor MM.
# Prioridade: EF_INTAKE_MODEL > LLM_MODEL > LLM_MODEL_MAIN
EF_INTAKE_MODEL=claude-haiku-4-5-20251001
EF_INTAKE_MAX_TOKENS=32000
# Leitura de imagens da EF: esbocos (padrão) | todas | nenhuma
#EF_INTAKE_IMAGENS=esbocos

# Modelo dos motores (ET Etapa 2). Se vazio, a plataforma usa o LLM_MODEL_MAIN.
#LLM_MODEL=
#LLM_MODEL_ANALYSIS=
#LLM_MAX_TOKENS=

# Prompt caching no chat (ligado por padrão; "off" desliga)
#PROMPT_CACHE=off

# Outro provedor configurado no config.yaml (opcional)
#XAI_API_KEY=xai-...

# -----------------------------------------------------------------------------
# 3. Generative Engine da Capgemini (motor de REMEDIAÇÃO usa só ela)
# -----------------------------------------------------------------------------
#LLM_API_KEY=
#WORKSPACE_ID=
#LLM_BASE_URL=
#LLM_MODEL_TRIAGE=
#LLM_MODEL_NAMING=

# -----------------------------------------------------------------------------
# 4. Ajustes finos dos motores (opcionais; sem eles valem os padrões do código)
# -----------------------------------------------------------------------------
# Comuns
#SAP_TARGET_VERSION=
#RAG_DOCUMENTS=
#NAMING_WORKBOOK_NAME=

# Motor de ET
#ET_TEMPLATE_NAME=
#ET_CALL_TIMEOUT_S=
#ET_RETRY_ATTEMPTS=
#ET_DRY_RUN=
#DOC_MAX_UNIT_CHARS=
#ET_AUTOR_FIXO=
#ET_FIXED_AUTOR=
#ET_FIXED_ANALISTA=
#ET_FIXED_VERSAO=
#ET_VERSAO_FIXA=
#ET_NAO_INFORMADO=

# Motor de remediação
#SAP_PACKAGE=
#ATC_CHECK_VARIANT=
#ENABLE_TRIAGE=
#ENABLE_NAMING_CHECK=
#NAMING_SOURCE_CHAR_LIMIT=
#REMEDIATION_CALL_TIMEOUT_S=
#REMEDIATION_RETRY_ATTEMPTS=
#REMEDIATION_MAX_WORKERS=
#REMEDIATION_CHUNKING=
#REMEDIATION_CHUNK_CHARS=
#REMEDIATION_WHOLE_LIMIT=
#REMEDIATION_MAX_MARK_OCCURRENCES=
#REMEDIATION_SKIP_EXISTING=

# -----------------------------------------------------------------------------
# 5. Plataforma (opcionais)
# Raiz do projeto (padrão: diretório atual)
#OPUSCORE_HOME=
# Pasta de dados: banco, uploads, artefatos, cache, auditoria (padrão: <raiz>/data)
#OPUSCORE_DATA=
# Caminho do config.yaml (padrão: <raiz>/config/config.yaml)
#OPUSCORE_CONFIG=
# Banco SQLite (padrão: <dados>/opuscore.db) ou outro banco por URL (ex.: Postgres)
#OPUSCORE_DB=
#OPUSCORE_DB_URL=
# Consultores que sobem (vazio = todos os instalados), ex.: funcional-mm,orquestrador
#OPUSCORE_PLUGINS=
# Conectores ativos no servidor MCP (vazio = conectores.habilitados do config.yaml)
#OPUSCORE_CONECTORES=
# Template de EF do projeto (padrão: config/templates/EF_template.docx)
#EF_TEMPLATE=

# -----------------------------------------------------------------------------
# NÃO coloque no .env: a plataforma define estas a cada execução dos motores
#   DIR_EF, DIR_CODIGOS, DIR_ET_GERADA, DIR_ARTEFATOS, DIR_TEMPLATE_LOCAL,
#   ET_OUTBOUND_DIR, FILE_OBJETOS, FILE_PAYLOAD, FILE_REQUISITOS,
#   REMEDIATION_INPUT_DIR, REMEDIATION_OUTPUT_DIR, LLM_USAGE_LOG
# E estas vêm do sistema operacional: USER, USERNAME
# -----------------------------------------------------------------------------
