DATA lv_repid TYPE sy-repid.

lv_repid = sy-repid.

zclsd_zesd_precos_leroy=>user_exit_execute(
  EXPORTING
    p_livar  = p_livar
    so_matnr = so_matnr[]
    sy_repid = lv_repid
  CHANGING
    so_werks = so_werks[]
    so_pltyp = so_pltyp[]
    pispc    = pispc
    s_werks  = s_werks[]
    s_pltyp  = s_pltyp[]
).