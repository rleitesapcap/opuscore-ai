*---------------------------------------------------------------------*
* Declaração: TABSTRIP Controle
*---------------------------------------------------------------------*
CONSTANTS: BEGIN OF c_tab_geral,
             tab1 LIKE sy-ucomm VALUE 'TAB_GERAL_FC1',
             tab2 LIKE sy-ucomm VALUE 'TAB_GERAL_FC2',
             tab3 LIKE sy-ucomm VALUE 'TAB_GERAL_FC3',
             tab4 LIKE sy-ucomm VALUE 'TAB_GERAL_FC4',
             tab5 LIKE sy-ucomm VALUE 'TAB_GERAL_FC5',
           END OF c_tab_geral.

CONTROLS:  tab_geral TYPE TABSTRIP.

DATA: BEGIN OF g_tab_geral,
        subscreen   LIKE sy-dynnr,
        prog        LIKE sy-repid VALUE 'ZRMM_CADASTRO_PRECO_ADMINISTR',
        pressed_tab LIKE sy-ucomm VALUE c_tab_geral-tab1,
      END OF g_tab_geral.


