*(aproveitando declarações e dados do bloco acima)

    IF <fs_wa_kalp>-ekals = lc_zpc007.

      DATA:
        tl_ekomv1 TYPE TABLE OF komv, " WITH HEADER LINE,
        tl_ekomv2 TYPE TABLE OF komv, " WITH HEADER LINE,
        lr_kschl1 TYPE RANGE OF kscha,
        el_kschl1 LIKE LINE OF lr_kschl1,
        lr_kschl2 TYPE RANGE OF kscha,
        el_kschl2 LIKE LINE OF lr_kschl2,
        lr_krech  TYPE RANGE OF krech,
        el_krech  LIKE LINE OF lr_krech.

      lr_kschl1 = zcl_parametros=>get_param( iv_processo = 'MM_011_04_KSCHL1' iv_name = 'KSCHA' ).
      lr_kschl2 = zcl_parametros=>get_param( iv_processo = 'MM_011_05_KSCHL2' iv_name = 'KSCHA' ).
      lr_krech  = zcl_parametros=>get_param( iv_processo = 'MM_011_06_KRECH' iv_name = 'KRECH' ).

      el_kschl1 = VALUE #( lr_kschl1[ 1 ] OPTIONAL ).
      el_kschl2 = VALUE #( lr_kschl2[ 1 ] OPTIONAL ).
      el_krech  = VALUE #( lr_krech[ 1 ] OPTIONAL ).

      tl_ekomv1[] = <fs_ekomv>[].

      SORT tl_ekomv1 BY kposn kschl.

*identificar a ultima linha
      tl_ekomv2[] = <fs_ekomv>[].
      SORT tl_ekomv2 BY knumv DESCENDING
                        kposn DESCENDING
                        stunr DESCENDING
                        zaehk DESCENDING.

      READ TABLE tl_ekomv2 INDEX 1 ASSIGNING FIELD-SYMBOL(<tl_ekomv2>).

*ler a linha a ser copiada
      READ TABLE tl_ekomv1 ASSIGNING FIELD-SYMBOL(<tl_ekomv1>)
                           WITH KEY kposn = <fs_wa_kalp>-kposn
                                    kschl = el_kschl1-low
                                    BINARY SEARCH.

      IF sy-subrc IS INITIAL AND <tl_ekomv1> IS ASSIGNED.

        APPEND <tl_ekomv1> TO tl_ekomv1. "Duplica a condição ZPB0

*Transforma uma das condições ZPB0 para a condição ZPB1
*Com isso a condição ZPB1 começa a aparecer no esquema de cálculo
        <tl_ekomv1>-kschl = el_kschl2-low. "'ZPB1'
        <tl_ekomv1>-stunr = 2.
        <tl_ekomv1>-zaehk = ( <tl_ekomv2>-zaehk + 1 ).
        <tl_ekomv1>-krech = el_krech-low. "'C'


        <fs_ekomv>[] = tl_ekomv1[]. "tabela do standard

        <fs_wa_kalp>-ekpgr = <tl_ekomv1>-kbetr / <tl_ekomv1>-kpein.

      ENDIF.
    ENDIF.


**********************************************************************
*                         Change History                             *
*                                                                    *
**********************************************************************
* Date         Reference       Author                                *
*====================================================================*
*  Iguala as condições de primeir0 preço para o Ecommerce           *
**********************************************************************

    IF <fs_kalp> IS ASSIGNED.
      LOOP AT <fs_kalp> ASSIGNING <fs_wa_kalp>. ##NEEDED
        CHECK <fs_wa_kalp>-kposn EQ pi_i_kalp-kposn.

        IF <fs_wa_kalp>-vkals = 'ZPVMAR' OR
           <fs_wa_kalp>-vkals = 'ZPV005'.
          IF <fs_wa_kalp>-vkals = 'ZPVMAR'.
*            <fs_wa_kalp>-zzkpe = <fs_wa_kalp>-endpr.
*            <fs_wa_kalp>-zzvle = <fs_wa_kalp>-vkp01.
*            <fs_wa_kalp>-zzlie = <fs_wa_kalp>-spane.
*            <fs_wa_kalp>-zzmle = <fs_wa_kalp>-vkp03.
*            <fs_wa_kalp>-zzmge = <fs_wa_kalp>-vkp11.
*            <fs_wa_kalp>-zzste = <fs_wa_kalp>-zstco.
          ELSE.
*            <fs_wa_kalp>-zzkpe = <fs_wa_kalp>-endpr.
*            <fs_wa_kalp>-zzvle = <fs_wa_kalp>-vkp01.
*            <fs_wa_kalp>-zzlie = <fs_wa_kalp>-spane.
*            <fs_wa_kalp>-zzmle = <fs_wa_kalp>-vkp02.
*            <fs_wa_kalp>-zzmge = <fs_wa_kalp>-vkp11.
*            <fs_wa_kalp>-zzste = <fs_wa_kalp>-zstco.
          ENDIF.
        ENDIF.
      ENDLOOP.
    ENDIF.

* Preencher campos ZPRA (Preço Aconselhado a Prazo) e ZPRAD (% desconto) na VKP5
    IF sy-tcode = lc_vkp5.

      lr_werks = zcl_parametros=>get_param( iv_processo = 'SD_PR.01961_PRECO_PIX_ETIQUETA' iv_name = 'LOJA' ).

      IF <fs_kalp> IS ASSIGNED.


        SELECT kunnr, pltyp
          FROM knvv
          INTO TABLE @DATA(lt_knvv)
          FOR ALL ENTRIES IN @<fs_kalp>
           WHERE pltyp EQ @<fs_kalp>-pltyp.

        IF sy-subrc IS INITIAL.

          SORT lt_knvv BY kunnr.

        ENDIF.

        LOOP AT <fs_kalp> ASSIGNING <fs_wa_kalp>. ##NEEDED
          CHECK <fs_wa_kalp>-kposn EQ pi_i_kalp-kposn.

          "Verificar centro
          vl_werks = <fs_wa_kalp>-werks.

          IF <fs_wa_kalp>-werks IS INITIAL AND <fs_wa_kalp>-pltyp IS NOT INITIAL.
            "Buscar centro da lista
            vl_kunnr = VALUE #( lt_knvv[ pltyp = <fs_wa_kalp>-pltyp ]-kunnr OPTIONAL ).

            "Verificar se é CD ou Refsite, se for, buscar o próximo
            IF vl_kunnr(1) = '0' AND vl_kunnr+6(4) IN lr_werks."Verificar se o centro está cadastrado

              SELECT SINGLE plant
                FROM i_plant
                INTO @vl_werks
                WHERE plant         = @vl_kunnr+6(4)
                  AND plantcategory = 'A'.
              IF sy-subrc EQ 0.
                EXIT.
              ENDIF.

            ENDIF.

            IF sy-subrc EQ 0.
              vl_werks = vl_kunnr+6(4).
            ENDIF.

          ENDIF.

*        TRY.
*            DATA(lo_data2) = zcl_sd_env_preco_kafka=>get_instance( ).
*            IF lo_data2 IS BOUND.
*              CALL METHOD lo_data2->calculate_price_virtual
*                EXPORTING
*                  i_werks = vl_werks
*                  i_kbetr = <fs_wa_kalp>-zvkp0
*                  i_kschl = 'VKP0'
*                  i_matnr = <fs_wa_kalp>-matnr
*                IMPORTING
*                  o_preco = <fs_wa_kalp>-zpra.
*            ENDIF.
*        ENDTRY.
*
*        IF <fs_wa_kalp>-zpra > 0 AND <fs_wa_kalp>-endpr > 0.
*          <fs_wa_kalp>-zprad = ( ( 100 - ( ( <fs_wa_kalp>-endpr / <fs_wa_kalp>-zpra ) * 100 ) ) * -1 ) * 10.
*        ENDIF.

        ENDLOOP.

      ENDIF.

    ENDIF.

  ENDMETHOD.


