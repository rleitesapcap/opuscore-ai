class ZCLSD_EXIT_SAPLWVK1_003 definition
  public
  final
  create public .

public section.

  interfaces YIFXX_CHECK_EXIT .

  class-methods USER_EXIT_EXECUTE
    importing
      !PI_KALP_UPDKZ type KALP-UPDKZ
      !PI_I_KALP type KALP
      !PI_I_VORGA type PISVR-VORGA
      !PI_I_GLOB type GLOB
    exporting
      !PE_I_ERRO type ERRO_TEMP .
protected section.
private section.

  class-methods USER_EXIT_OLD_CODE
    importing
      !PI_KALP_UPDKZ type KALP-UPDKZ
      !PI_I_KALP type KALP
      !PI_I_VORGA type PISVR-VORGA
      !PI_I_GLOB type GLOB
    exporting
      !PE_I_ERRO type ERRO_TEMP .
ENDCLASS.



